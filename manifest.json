{
  "manifest_version": 3,
  "name": "Wordle Archive Navigation",
  "version": "1.0.0",
  "description": "Adds previous and next day controls to the Wordle archive.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle",
        "https://www.nytimes.com/games/wordle/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
